   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(pond_catchment_area_ha_sum{job=\"jaldrishti/pond-worker\"}[5m])) / sum(rate(pond_catchment_area_ha_count{job=\"jaldrishti/pond-worker\"}[5m]))",
     "legendFormat": "catchment (ha)",
     "range": true,
