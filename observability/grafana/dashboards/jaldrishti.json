       {
        "id": "custom.axisPlacement",
        "value": "right"
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 15,
   "type": "timeseries",
   "title": "Gateway (Go) memory and goroutines",
   "description": "Go runtime metrics (contrib/instrumentation/runtime).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 28,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(go_memory_used_bytes{job=\"jaldrishti/pond-gateway\"})",
     "legendFormat": "memory used",
     "range": true,
     "instant": false
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "go_goroutine_count{job=\"jaldrishti/pond-gateway\"}",
