{
 "uid": "jaldrishti",
 "title": "JalDrishti - pond planner (OpenTelemetry)",
 "description": "Gateway, workers and pipeline of the village pond planner, from OpenTelemetry metrics and logs.",
 "tags": [
  "jaldrishti",
  "opentelemetry"
 ],
 "timezone": "browser",
 "editable": true,
 "graphTooltip": 1,
 "refresh": "10s",
 "schemaVersion": 41,
 "version": 1,
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Workers up",
   "description": "Workers that passed the gateway's last health check (out of 2).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(pond_gateway_worker_up_ratio{job=\"jaldrishti/pond-gateway\"})",
     "legendFormat": "up",
     "range": true,
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "min": 0,
     "max": 2,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       },
       {
        "color": "green",
        "value": 2
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "value_and_name",
    "justifyMode": "auto"
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "API requests / s",
   "description": "Requests through the gateway, last minute.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(http_server_request_duration_seconds_count{job=\"jaldrishti/pond-gateway\"}[1m]))",
     "legendFormat": "req/s",
     "range": true,
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {},
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "value_and_name",
    "justifyMode": "auto"
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Cache hit ratio",
   "description": "Share of cacheable requests answered without new work (hit or shared).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(rate(pond_gateway_cache_lookups_total{job=\"jaldrishti/pond-gateway\",pond_cache_result=~\"hit|shared\"}[5m])) / sum(rate(pond_gateway_cache_lookups_total{job=\"jaldrishti/pond-gateway\",pond_cache_result!=\"bypass\"}[5m]))",
     "legendFormat": "hit ratio",
     "range": true,
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {},
     "unit": "percentunit"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "value_and_name",
    "justifyMode": "auto"
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "p95 analysis latency",
   "description": "95th percentile end-to-end time of analysis requests at the gateway.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"jaldrishti/pond-gateway\",http_route=~\"/api/analyze.*|/api/sample|/analyzeContour|/findCatchment\"}[5m])))",
     "legendFormat": "p95",
     "range": true,
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {},
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "value_and_name",
    "justifyMode": "auto"
   }
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Shed with 503 (since start)",
   "description": "Requests the gateway refused because no worker slot became free in time (counter since the gateway started).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(pond_gateway_shed_total{job=\"jaldrishti/pond-gateway\"}) or vector(0)",
     "legendFormat": "shed",
     "range": true,
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {}
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "value_and_name",
    "justifyMode": "auto"
   }
  },
  {
   "id": 6,
   "type": "stat",
   "title": "Retries (since start)",
   "description": "Requests the gateway had to send to a second worker (counter since the gateway started).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 20,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(pond_gateway_retries_total{job=\"jaldrishti/pond-gateway\"}) or vector(0)",
     "legendFormat": "retries",
     "range": true,
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {}
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "value_and_name",
    "justifyMode": "auto"
   }
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Gateway requests by route and cache result",
   "description": "otelhttp server metric, labelled with the route and the gateway cache result.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (http_route, pond_cache) (rate(http_server_request_duration_seconds_count{job=\"jaldrishti/pond-gateway\"}[1m]))",
     "legendFormat": "{{http_route}} {{pond_cache}}",
     "range": true,
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12,
      "showPoints": "never",
      "spanNulls": true,
      "stacking": {
       "mode": "normal"
      }
     },
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Analysis latency at the gateway (p50 / p95 / p99)",
   "description": "Diamonds are exemplars: individual slow requests, each linked to its trace.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.5, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"jaldrishti/pond-gateway\",http_route=~\"/api/analyze.*|/api/sample|/analyzeContour|/findCatchment\"}[1m])))",
     "legendFormat": "p50",
     "range": true,
     "instant": false
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"jaldrishti/pond-gateway\",http_route=~\"/api/analyze.*|/api/sample|/analyzeContour|/findCatchment\"}[1m])))",
     "legendFormat": "p95",
     "range": true,
     "instant": false
    },
    {
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"jaldrishti/pond-gateway\",http_route=~\"/api/analyze.*|/api/sample|/analyzeContour|/findCatchment\"}[1m])))",
     "legendFormat": "p99",
     "range": true,
     "instant": false,
     "exemplar": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12,
      "showPoints": "never",
      "spanNulls": true,
      "stacking": {
       "mode": "none"
      }
     },
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Pipeline stage time (worker, average per call)",
   "description": "Mean duration of each stage of the analysis pipeline (manual spans + histogram).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (pond_stage) (rate(pond_analysis_stage_duration_seconds_sum{job=\"jaldrishti/pond-worker\"}[2m])) / sum by (pond_stage) (rate(pond_analysis_stage_duration_seconds_count{job=\"jaldrishti/pond-worker\"}[2m]))",
     "legendFormat": "{{pond_stage}}",
     "range": true,
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12,
      "showPoints": "never",
      "spanNulls": true,
      "stacking": {
       "mode": "none"
      }
     },
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Queue wait and upstream time by worker",
   "description": "Admission-control queue (gateway) versus the time the workers take.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(pond_gateway_queue_wait_seconds_bucket{job=\"jaldrishti/pond-gateway\"}[1m])))",
     "legendFormat": "p95 wait for a worker slot",
     "range": true,
     "instant": false
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le, pond_worker) (rate(pond_gateway_upstream_duration_seconds_bucket{job=\"jaldrishti/pond-gateway\"}[1m])))",
     "legendFormat": "p95 upstream {{pond_worker}}",
     "range": true,
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12,
      "showPoints": "never",
      "spanNulls": true,
      "stacking": {
       "mode": "none"
      }
     },
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Load: waiting in the gateway queue and in flight per worker",
   "description": "Gauges observed by the gateway every 10 s.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "pond_gateway_queue_waiting{job=\"jaldrishti/pond-gateway\"}",
     "legendFormat": "waiting in gateway queue",
     "range": true,
     "instant": false
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "pond_gateway_worker_inflight{job=\"jaldrishti/pond-gateway\"}",
     "legendFormat": "in flight {{pond_worker}}",
     "range": true,
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12,
      "showPoints": "never",
      "spanNulls": true,
      "stacking": {
       "mode": "none"
      }
     },
     "unit": "short"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "Worker memory (RSS) and CPU",
   "description": "System metrics instrumentation in the Python workers (limit 512 MiB, 1 CPU each).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "process_memory_usage_bytes{job=\"jaldrishti/pond-worker\"}",
     "legendFormat": "RSS {{instance}}",
     "range": true,
     "instant": false
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (instance) (rate(process_cpu_time_seconds_total{job=\"jaldrishti/pond-worker\"}[1m]))",
     "legendFormat": "CPU cores {{instance}}",
     "range": true,
     "instant": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12,
      "showPoints": "never",
      "spanNulls": true,
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": "RSS.*"
      },
      "properties": [
       {
        "id": "unit",
        "value": "bytes"
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "CPU.*"
      },
      "properties": [
       {
        "id": "unit",
        "value": "short"
       },
       {
        "id": "custom.axisPlacement",
        "value": "right"
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
