     "expr": "sum(rate(pond_water_collectable_m3_sum{job=\"jaldrishti/pond-worker\"}[5m])) / sum(rate(pond_water_collectable_m3_count{job=\"jaldrishti/pond-worker\"}[5m]))",
     "legendFormat": "collectable water (m3)",
     "range": true,
